[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/boot.gd" id="1_boot"]

[node name="Boot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_boot")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.045, 0.05, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
text = "UNNAMED HUNT RPG"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
text = "Stage 1 • Galaxy A03s Engine / Android Probe"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
text = "Godot 4.7 • GL Compatibility • landscape"
horizontal_alignment = 1

[node name="StartProbe" type="Button" parent="Center/Panel/Content"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
text = "START 3D PROBE"

[node name="Note" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
text = "Probe-only source. No real combat or production assets."
horizontal_alignment = 1

[connection signal="pressed" from="Center/Panel/Content/StartProbe" to="." method="_on_start_probe_pressed"]
