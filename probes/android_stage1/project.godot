; Engine configuration file.
; Stage 1 Android probe only. Not the production game project.
config_version=5

[application]
config/name="Unnamed Hunt RPG - Stage 1 Android Probe"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/frame_pacing/android/enable_frame_pacing=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.05, 1)

[physics]
common/enable_pause_aware_picking=true
